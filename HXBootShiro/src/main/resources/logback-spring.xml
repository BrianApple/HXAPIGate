<?xml version="1.0" encoding="UTF-8"?>
<!-- HXBootShiro 管理端日志配置：slf4j + logback，按天+大小滚动，历史最多保留 90 天 -->
<configuration scan="true">

	<contextName>usThe</contextName>
	<!-- 统一日志目录：<模块目录>/logs/<appName>/，按天+大小滚动，历史最多保留 90 天 -->
	<property name="LOG_HOME" value="./logs" />
	<property name="appName" value="HXBootShiro"></property>

	<!-- 统一日志格式：时间 [线程] 级别 [traceId] [proto] [frameId] logger : line - msg -->
	<property name="LOG_PATTERN" value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level [%X{traceId:--}] [%X{proto:--}] [%X{frameId:--}] %logger{50} : %line - %msg%n" />

	<!-- 控制台输出 -->
	<appender name="ConsoleAppender" class="ch.qos.logback.core.ConsoleAppender">
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>${LOG_PATTERN}</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<!-- 全量运行日志：INFO/WARN（ERROR 单独进 ErrOut，避免重复），按天+大小滚动，保留 90 天 -->
	<appender name="SystemOutFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_HOME}/${appName}/SystemOut.log</file>
		<append>true</append>
		<!-- 排除 ERROR（交给 ErrOutFileAppender），其余 INFO 及以上进入本文件 -->
		<filter class="ch.qos.logback.classic.filter.LevelFilter">
			<level>ERROR</level>
			<onMatch>DENY</onMatch>
			<onMismatch>NEUTRAL</onMismatch>
		</filter>
		<filter class="ch.qos.logback.classic.filter.ThresholdFilter">
			<level>INFO</level>
		</filter>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${LOG_HOME}/${appName}/SystemOut-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxHistory>90</maxHistory>
			<timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<maxFileSize>50MB</maxFileSize>
			</timeBasedFileNamingAndTriggeringPolicy>
		</rollingPolicy>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>${LOG_PATTERN}</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<!-- 错误日志：仅 ERROR，按天+大小滚动，保留 90 天 -->
	<appender name="ErrOutFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_HOME}/${appName}/SystemErrOut.log</file>
		<append>true</append>
		<filter class="ch.qos.logback.classic.filter.LevelFilter">
			<level>ERROR</level>
			<onMatch>ACCEPT</onMatch>
			<onMismatch>DENY</onMismatch>
		</filter>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${LOG_HOME}/${appName}/SystemErrOut-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxHistory>90</maxHistory>
			<timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<maxFileSize>50MB</maxFileSize>
			</timeBasedFileNamingAndTriggeringPolicy>
		</rollingPolicy>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>${LOG_PATTERN}</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<!-- SQL 日志：DEBUG（配合 mybatis mapper 调试），按天+大小滚动，保留 90 天 -->
	<appender name="SqlOutFileAppender" class="ch.qos.logback.core.rolling.RollingFileAppender">
		<file>${LOG_HOME}/${appName}/SystemSqlOut.log</file>
		<append>true</append>
		<filter class="ch.qos.logback.classic.filter.LevelFilter">
			<level>DEBUG</level>
			<onMatch>ACCEPT</onMatch>
			<onMismatch>DENY</onMismatch>
		</filter>
		<rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
			<fileNamePattern>${LOG_HOME}/${appName}/SystemSqlOut-%d{yyyy-MM-dd}.%i.log</fileNamePattern>
			<maxHistory>90</maxHistory>
			<timeBasedFileNamingAndTriggeringPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedFNATP">
				<maxFileSize>50MB</maxFileSize>
			</timeBasedFileNamingAndTriggeringPolicy>
		</rollingPolicy>
		<encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
			<pattern>${LOG_PATTERN}</pattern>
			<charset>UTF-8</charset>
		</encoder>
	</appender>

	<!-- 框架日志级别控制 -->
	<logger name="org.springframework" level="info"/>
	<logger name="org.json" level="error"/>
	<logger name="io.netty" level="info"/>
	<logger name="org.slf4j" level="info"/>
	<logger name="ch.qos.logback" level="info"/>

	<!-- 生产环境 -->
	<springProfile name="prod">
		<logger name="com.usthe.bootshiro.dao">
			<level value="DEBUG"/>
			<appender-ref ref="SqlOutFileAppender"/>
		</logger>
		<root level="INFO">
			<appender-ref ref="ErrOutFileAppender"/>
			<appender-ref ref="SystemOutFileAppender"/>
			<appender-ref ref="ConsoleAppender"/>
		</root>
	</springProfile>

	<!-- 测试环境 -->
	<springProfile name="test">
		<logger name="com.usthe.bootshiro.dao">
			<level value="DEBUG"/>
			<appender-ref ref="SqlOutFileAppender"/>
		</logger>
		<root level="INFO">
			<appender-ref ref="ErrOutFileAppender"/>
			<appender-ref ref="SystemOutFileAppender"/>
			<appender-ref ref="ConsoleAppender"/>
		</root>
	</springProfile>

	<!-- 开发环境（同样写文件，保证本地也有完整日志） -->
	<springProfile name="dev">
		<root level="INFO">
			<appender-ref ref="ErrOutFileAppender"/>
			<appender-ref ref="SystemOutFileAppender"/>
			<appender-ref ref="ConsoleAppender"/>
		</root>
	</springProfile>

</configuration>
